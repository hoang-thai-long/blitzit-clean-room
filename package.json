{
  "name": "local-focus-workspace",
  "private": true,
  "version": "1.1.0",
  "description": "Daylight — local-first focus workspace for Linux",
  "author": { "name": "Daylight", "email": "daylight@localhost.invalid" },
  "main": "desktop-dist/main.cjs",
  "homepage": "https://example.invalid/daylight",
  "desktopName": "daylight.desktop",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:compile": "node scripts/build-desktop.mjs",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:start": "electron .",
    "desktop:dev": "npm run desktop:build && electron .",
    "package:linux": "npm run desktop:build && electron-builder --linux deb AppImage --x64",
    "test:desktop": "node --env-file=.env node_modules/@playwright/test/cli.js test --config playwright.desktop.config.ts",
    "test:postgres": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.postgres.config.ts",
    "db:setup": "node scripts/setup-local-db.mjs",
    "desktop:local": "node --env-file=.env scripts/start-desktop.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "api:dev": "node --env-file-if-exists=.env --import tsx api/server.ts",
    "api:build": "tsc -p tsconfig.api.json && node scripts/build-api.mjs",
    "api:start": "node --env-file-if-exists=.env api-dist/server.mjs",
    "api:db:migrate": "node --env-file-if-exists=.env --import tsx api/migrate.ts",
    "test:api": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.api.config.ts",
    "api:up": "docker compose --profile api up -d --build --wait",
    "api:down": "docker compose --profile api stop api",
    "api:logs": "docker compose logs -f api",
    "api:smoke": "node --env-file-if-exists=.env scripts/api-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "pg": "^8.16.3",
    "fastify": "^5.6.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^6.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.6"
  },
  "build": {
    "appId": "local.daylight.focus",
    "productName": "Daylight",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop-dist/**/*", "database/*.sql", "package.json"],
    "asar": true,
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "daylight",
      "syncDesktopName": true,
      "desktop": { "entry": { "Name": "Daylight", "Comment": "Focus workspace with a floating island timer", "StartupWMClass": "Daylight" } }
    },
    "deb": { "depends": ["libgtk-3-0", "libnss3", "libxss1", "libxtst6", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "libgbm1", "libasound2 | libasound2t64"] },
    "artifactName": "Daylight-${version}-${arch}.${ext}"
  }
}
