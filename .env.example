# Copy to .env and set your own password, or run npm run db:setup.
DAYLIGHT_DB_PASSWORD=replace-with-your-local-password
DAYLIGHT_DB_PORT=54329
DAYLIGHT_DB_HOST=127.0.0.1
DAYLIGHT_DB_NAME=daylight
DAYLIGHT_DB_USER=daylight
DAYLIGHT_DB_SSL=false
DAYLIGHT_DB_POOL_MAX=8
DAYLIGHT_DB_CONNECT_TIMEOUT_MS=3000
DAYLIGHT_DB_QUERY_TIMEOUT_MS=5000
DAYLIGHT_DB_LOCK_TIMEOUT_MS=750

# Optional connection URL overrides host/port/name/user/password above.
# DAYLIGHT_DATABASE_URL=postgresql://daylight:YOUR_PASSWORD@127.0.0.1:54329/daylight
# With TLS, verify certificates. Optional custom CA for a private PostgreSQL server:
# DAYLIGHT_DB_CA_FILE=/absolute/path/to/ca.pem

# Local REST API, without product authentication (not a public multi-user service).
DAYLIGHT_API_HOST=127.0.0.1
DAYLIGHT_API_PORT=3001
DAYLIGHT_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DAYLIGHT_API_TIME_ZONE=Asia/Ho_Chi_Minh
DAYLIGHT_API_LOG_LEVEL=info
